CADENA_RUNTIME_MODE=staging
PORT=3000
DATABASE_URL=postgresql://cadena:REPLACE_ME@postgres.example.internal:5432/cadena
CADENA_DATABASE_SSL=verify-full
CADENA_DATABASE_CA_BASE64=BASE64_ENCODED_DATABASE_CA_CERTIFICATE
CADENA_DATABASE_POOL_MAX=10
CADENA_DATABASE_CONNECT_TIMEOUT_MS=10000
CADENA_DATABASE_IDLE_TIMEOUT_MS=30000
CADENA_BOOTSTRAP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CADENA_ALLOW_HEADER_AUTH=false
CADENA_SEED_DEMO_DATA=false
CADENA_TRUST_PROXY=1
CADENA_CORS_ORIGINS=https://staging.cadena.example
CADENA_SERVICE_NAME=cadena-api
CADENA_BUILD_SHA=SET_BY_DEPLOYMENT_PIPELINE
