{
  "name": "cadena-platform",
  "version": "0.1.0",
  "description": "Unified SDLC & ITSM Platform - Pilot Build",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run --exclude test/ui-smoke.spec.ts --exclude \"**/node_modules/**\"",
    "test:watch": "vitest",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test:ui": "tsc && vitest run test/ui-smoke.spec.ts",
    "tracker": "node scripts/build-tracker.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "ajv": "^8.20.0",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "puppeteer-core": "^25.11.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
