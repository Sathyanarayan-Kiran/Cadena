{
  "name": "cadena-platform",
  "version": "0.1.0",
  "description": "Unified SDLC & ITSM Platform - Pilot Build",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run --exclude test/ui-smoke.spec.ts --exclude \"**/node_modules/**\"",
    "test:watch": "vitest",
    "build": "tsc",
    "dev": "cross-env CADENA_DATA_DIR=./data CADENA_ALLOW_HEADER_AUTH=true tsx watch src/server.ts",
    "start": "cross-env CADENA_DATA_DIR=./data node dist/server.js",
    "start:staging": "cross-env CADENA_RUNTIME_MODE=staging node dist/server.js",
    "staging:validate": "tsx src/scripts/validate-runtime.ts",
    "test:ui": "tsc && vitest run test/ui-smoke.spec.ts",
    "tracker": "node scripts/build-tracker.mjs",
    "dev:ephemeral": "cross-env CADENA_ALLOW_HEADER_AUTH=true tsx watch src/server.ts",
    "db:reset": "node -e \"require('fs').rmSync('./data',{recursive:true,force:true});console.log('data directory removed')\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/serve-static": "^12.0.0",
    "ajv": "^8.20.0",
    "express": "^5.1.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "puppeteer-core": "^25.11.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.1"
  }
}
